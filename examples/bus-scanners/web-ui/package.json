  "scripts": {
    "build": "NODE_OPTIONS='--preserve-symlinks' webpack --config-node-env=production",
    "compile": "NODE_OPTIONS='--preserve-symlinks' webpack --config-node-env=development",
    "analyze": "NODE_OPTIONS='--preserve-symlinks' webpack --config-node-env=production --env destination=analyze",
    "start": "NODE_OPTIONS='--preserve-symlinks' webpack serve --config-node-env=development"
  },
  "devDependencies": {
    "@ts-libs/dev": "*",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0"
  },
  "dependencies": {
    "@esp32m/ui": "*",
    "@ts-libs/ui-app": "*",
    "lodash": "^4.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "packageManager": "yarn@4.18.1"
}
